# DO NOT commit real keys. Paste the real values into:
#   Streamlit Community Cloud -> your app -> Settings -> Secrets
# (this file is only a template; the real secrets.toml is git-ignored)

# --- LLM (free tiers). Gemini alone is enough to start. ---
GEMINI_API_KEY = ""        # https://aistudio.google.com/apikey
GROQ_API_KEY = ""          # optional backup: https://console.groq.com/keys
OPENROUTER_API_KEY = ""    # optional 2nd backup: https://openrouter.ai/keys

# --- Global search (free) ---
OPENALEX_API_KEY = ""      # free account at https://openalex.org -> Settings -> API
TAVILY_API_KEY = ""        # https://app.tavily.com  (1,000 free credits / month)

# --- Optional overrides (defaults shown) ---
# GEMINI_MODEL = "gemini-flash-latest"
# GROQ_MODEL = "openai/gpt-oss-120b"
# OPENROUTER_MODEL = "openrouter/free"
# LLM_ORDER = "gemini,groq,openrouter"
# EMBEDDING_MODEL = "BAAI/bge-small-en-v1.5"   # only used if embedding_info.json is missing
